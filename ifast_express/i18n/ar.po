#: model:ir.model.fields,field_description:ifast_express.field_res_config_settings__ifast_connected
msgid "iFAST connected"
msgstr "تم ربط iFAST"

#. module: ifast_express
#. odoo-python
#: code:addons/ifast_express/models/ifast_connector.py:0
msgid "iFAST could not be reached. Please try again in a minute."
msgstr "تعذر الوصول إلى iFAST. حاول مرة أخرى بعد دقيقة."

#. module: ifast_express
#. odoo-python
#: code:addons/ifast_express/models/delivery_carrier.py:0
msgid "iFAST could not cancel %(name)s: %(message)s"
msgstr "تعذر على iFAST إلغاء %(name)s: %(message)s"

#. module: ifast_express
#. odoo-python
#: code:addons/ifast_express/models/delivery_carrier.py:0
