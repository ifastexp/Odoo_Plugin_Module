msgid "Disconnect iFAST? Deliveries stop being sent until you connect again."
msgstr "قطع الربط مع iFAST؟ سيتوقف إرسال أوامر التوصيل حتى تعيد الربط."

#. module: ifast_express
#: model_terms:ir.ui.view,arch_db:ifast_express.view_picking_form_ifast
msgid "Fix it, then click Send to iFAST."
msgstr "صحّح ذلك، ثم اضغط إرسال إلى iFAST."

#. module: ifast_express
#. odoo-python
#: code:addons/ifast_express/models/delivery_carrier.py:0
