msgstr "تعذر على iFAST استلام %(name)s: %(message)s"

#. module: ifast_express
#. odoo-python
#: code:addons/ifast_express/models/ifast_connector.py:0
msgid ""
"iFAST did not accept this Odoo. Reconnect it in Settings > iFAST Express."
msgstr "لم تقبل iFAST هذا الـ Odoo. أعد الربط من الإعدادات > iFAST Express."

#. module: ifast_express
#. odoo-python
#: code:addons/ifast_express/models/ifast_connector.py:0
msgid "iFAST did not finish the connection. Please try again."
msgstr "لم تكمل iFAST الربط. حاول مرة أخرى."

#. module: ifast_express
#. odoo-python
#: code:addons/ifast_express/models/ifast_connector.py:0
