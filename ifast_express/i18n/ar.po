msgstr "لا يوجد سعر iFAST لهذا العنوان."

#. module: ifast_express
#: model:ir.model.fields,field_description:ifast_express.field_stock_picking__ifast_send_error
msgid "Not sent to iFAST"
msgstr "لم يُرسل إلى iFAST"

#. module: ifast_express
#. odoo-python
#: code:addons/ifast_express/models/stock_picking.py:0
msgid ""
"Not sent to iFAST: %s. Fix it, then click Send to iFAST or send it from the "
"iFAST console."
msgstr "لم يُرسل إلى iFAST: %s. صحّح ذلك، ثم اضغط إرسال إلى iFAST أو أرسله من لوحة iFAST."

