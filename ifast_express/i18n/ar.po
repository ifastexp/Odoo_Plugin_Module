msgstr "اختر أوامر التوصيل (الصادرة)."

#. module: ifast_express
#: model:ir.actions.server,name:ifast_express.action_ifast_send_pickings
#: model_terms:ir.ui.view,arch_db:ifast_express.view_picking_form_ifast
msgid "Send to iFAST"
msgstr "إرسال إلى iFAST"

#. module: ifast_express
#. odoo-python
#: code:addons/ifast_express/models/stock_picking.py:0
msgid "Sent to iFAST: %(tracking)s %(link)s"
msgstr "أُرسل إلى iFAST: %(tracking)s %(link)s"

#. module: ifast_express
#: model_terms:ir.ui.view,arch_db:ifast_express.res_config_settings_view_form_ifast
msgid ""
"Ship with iFAST Express: prices at checkout, send deliveries, AWB labels and"
" tracking. Connecting creates an Odoo API key for your user that iFAST uses "
"to read deliveries and write tracking back."
msgstr "اشحن مع iFAST Express: أسعار التوصيل عند الدفع، إرسال أوامر التوصيل، بوالص الشحن والتتبع. الربط ينشئ مفتاح API في Odoo لمستخدمك، تستخدمه iFAST لقراءة أوامر التوصيل وكتابة رقم التتبع."

#. module: ifast_express
#: model:ir.model,name:ifast_express.model_delivery_carrier
msgid "Shipping Methods"
msgstr "طرق الشحن"

#. module: ifast_express
#: model:ir.model.fields,help:ifast_express.field_res_config_settings__ifast_public_url
msgid ""
"The https address iFAST uses to reach this Odoo. Leave empty to use the web "
"base URL."
msgstr "عنوان https الذي تستخدمه iFAST للوصول إلى Odoo هذا. اتركه فارغاً لاستخدام عنوان الموقع الأساسي."

#. module: ifast_express
#: model:ir.model,name:ifast_express.model_stock_picking
msgid "Transfer"
