<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_ifast" model="ir.ui.view">
        <field name="name">stock.picking.form.ifast</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="carrier_tracking_ref" invisible="1"/>
                <field name="delivery_type" invisible="1"/>
                <button name="action_ifast_send" type="object" string="Send to iFAST"
                        groups="stock.group_stock_user"
                        invisible="picking_type_code != 'outgoing' or state in ('draft', 'cancel') or carrier_tracking_ref or (delivery_type and delivery_type != 'ifast')"/>
                <button name="action_ifast_print_awb" type="object" string="Print iFAST AWB"
                        groups="stock.group_stock_user"
                        invisible="picking_type_code != 'outgoing' or not carrier_tracking_ref or (delivery_type and delivery_type != 'ifast')"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="ifast_send_error" invisible="1"/>
                <div class="alert alert-warning mb-0" role="alert" invisible="not ifast_send_error or carrier_tracking_ref">
                    <strong>Not sent to iFAST:</strong> <field name="ifast_send_error" readonly="1" class="d-inline"/>
                    Fix it, then click Send to iFAST.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
